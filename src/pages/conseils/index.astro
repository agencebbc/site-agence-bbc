---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Rdv from '../../components/Rdv.astro';
import Bandeau from '../../components/Bandeau.astro';
import CarteArticle from '../../components/CarteArticle.astro';
import { CATEGORIES, type Categorie } from '../../data/agence';
import { schemaFilAriane } from '../../data/schema';

const articles = (await getCollection('conseils', ({ data }) => !data.brouillon)).sort(
  (a, b) => (b.data.misAJour ?? b.data.publie).getTime() - (a.data.misAJour ?? a.data.publie).getTime(),
);
const parCategorie = (Object.keys(CATEGORIES) as Categorie[])
  .map((id) => ({ id, ...CATEGORIES[id], articles: articles.filter((a) => a.data.categorie === id) }))
  .filter((c) => c.articles.length > 0);
const jsonLd = [schemaFilAriane(Astro.site!, [{ nom: 'Accueil', chemin: '/' }, { nom: 'Conseils', chemin: '/conseils/' }])];
---
<Base
  titre="Conseils assurance, patrimoine et retraite"
  description="Les réponses de l'agence BBC à Narbonne sur l'assurance, la prévoyance, l'épargne et la retraite : règles à jour, exemples chiffrés et points de vigilance."
  jsonLd={jsonLd}
>
  <Bandeau
    photo="carnet"
    titre="Conseils assurance, patrimoine et retraite"
    chapo="Les questions qu'on nous pose à l'agence, avec des réponses à jour de la réglementation et des exemples chiffrés. Chaque article est rédigé et relu par un agent général."
    ariane={[{ nom: 'Accueil', href: '/' }, { nom: 'Conseils' }]}
  />
  <div class="conteneur conseils">
    {parCategorie.map((c) => (
      <section id={c.id} class="categorie">
        <h2>{c.titre}</h2>
        <ul class="cartes">{c.articles.map((art) => <CarteArticle article={art} />)}</ul>
      </section>
    ))}
    <Rdv titre="Vous ne trouvez pas votre question ?" texte="Posez-la à l'agence : nous vous répondons, et elle deviendra peut-être notre prochain article." />
  </div>
</Base>

<style>
  .conseils { padding-block: clamp(2.5rem, 6vw, 4.5rem); }
  .categorie + .categorie { margin-top: 3rem; }
  .categorie h2 { font-size: clamp(1.4rem, 1.2rem + 0.8vw, 1.8rem); }
</style>
