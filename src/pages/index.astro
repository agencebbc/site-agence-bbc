---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Image from '../components/Image.astro';
import Fleche from '../components/Fleche.astro';
import CarteArticle from '../components/CarteArticle.astro';
import Avis from '../components/Avis.astro';
import { AGENCE, NOMS_AGENTS } from '../data/agence';
import type { CleePhoto } from '../data/photos';

const articles = (await getCollection('conseils', ({ data }) => !data.brouillon))
  .sort((a, b) => (b.data.misAJour ?? b.data.publie).getTime() - (a.data.misAJour ?? a.data.publie).getTime())
  .slice(0, 3);
const a = AGENCE;

const expertises = [
  {
    titre: 'Particuliers',
    photo: 'cles' as CleePhoto,
    lien: '/particuliers/',
    texte: 'Toutes les assurances de votre famille, suivies par une même équipe, avec une vue d’ensemble sur vos garanties.',
    points: ['Auto et deux-roues', 'Habitation, résidence secondaire, location', 'Complémentaire santé', 'Prévoyance et accidents de la vie', 'Assurance de prêt et banque'],
  },
  {
    titre: 'Gestion de patrimoine',
    photo: 'mas' as CleePhoto,
    lien: '/patrimoine/',
    texte: 'Épargne, retraite, transmission : une stratégie construite à partir de vos objectifs et de votre fiscalité, revue avec vous chaque année.',
    points: ['Bilan patrimonial et fiscal', 'Assurance vie et contrat de capitalisation', 'Plan d’épargne retraite (PER)', 'Prévoyance de la famille et du dirigeant', 'Préparation de la transmission'],
  },
  {
    titre: 'Assurance des entreprises',
    photo: 'chantier' as CleePhoto,
    lien: '/entreprises/',
    texte: 'Des garanties dimensionnées pour votre activité, de l’artisan seul à la PME, avec un interlocuteur qui connaît votre métier et votre territoire.',
    points: ['Multirisque professionnelle et pertes d’exploitation', 'Responsabilité civile et décennale', 'Flotte automobile et marchandises transportées', 'Santé et prévoyance collectives', 'Protection du dirigeant et homme clé'],
  },
];

const secteurs: { titre: string; photo: CleePhoto }[] = [
  { titre: 'Viticulture et négoce', photo: 'chai' },
  { titre: 'Artisans et bâtiment', photo: 'atelier' },
  { titre: 'Commerce et restauration', photo: 'commerce' },
  { titre: 'Transport et logistique', photo: 'camion' },
  { titre: 'Professions libérales', photo: 'carnet' },
];


const ic = (d: string) => `<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const themes = [
  { titre: 'Épargner', lien: '/patrimoine/', teinte: '#e7ebf7', icone: ic('<path d="M4 17l5-5 4 4 7-8"/><path d="M15 8h5v5"/>') },
  { titre: 'Préparer sa retraite', lien: '/patrimoine/', teinte: '#fde4e4', icone: ic('<circle cx="12" cy="12" r="8"/><path d="M12 8v4l3 2"/>') },
  { titre: 'Transmettre', lien: '/patrimoine/', teinte: '#efe9df', icone: ic('<path d="M20 12v8H4v-8"/><path d="M2 7h20v5H2z"/><path d="M12 20V7"/><path d="M12 7c-2-3-6-3-6 0h6zm0 0c2-3 6-3 6 0h-6z"/>') },
  { titre: 'Assurer mon entreprise', lien: '/entreprises/', teinte: '#e3f2ec', icone: ic('<path d="M3 21h18"/><path d="M5 21V8l7-4 7 4v13"/><path d="M9 21v-6h6v6"/>') },
  { titre: 'Protéger mes salariés', lien: '/entreprises/', teinte: '#e7ebf7', icone: ic('<circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.5"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><path d="M15 15c2.8-.6 6 1.2 6 5"/>') },
  { titre: 'Assurer ma passion', lien: '/passion/', teinte: '#e3f2ec', icone: ic('<circle cx="6" cy="16" r="3"/><circle cx="18" cy="16" r="3"/><path d="M6 16l4-7h5l3 7"/><path d="M9 6h3"/>') },
  { titre: 'Assurer ma famille', lien: '/particuliers/', teinte: '#fde4e4', icone: ic('<path d="M3 11l9-7 9 7"/><path d="M5 10v10h14V10"/><path d="M12 16.5s-3-1.8-3-3.6a1.6 1.6 0 0 1 3-.8 1.6 1.6 0 0 1 3 .8c0 1.8-3 3.6-3 3.6z"/>') },
];

const etapes = [
  { titre: 'Écouter', texte: 'Un premier rendez-vous, à l’agence ou chez vous, pour comprendre votre situation et vos projets.' },
  { titre: 'Analyser', texte: 'Un bilan de vos contrats, de votre patrimoine ou des risques de votre entreprise.' },
  { titre: 'Proposer', texte: 'Des solutions chiffrées et expliquées, avec pour certains risques d’entreprise une mise en concurrence de plusieurs assureurs.' },
  { titre: 'Suivre', texte: 'Un point chaque année et un interlocuteur dédié, y compris le jour où vous avez besoin de votre assurance.' },
];
---
<Base
  titre="Agence d'assurance à Narbonne : particuliers, patrimoine, entreprises | Agence BBC"
  description="Agence BBC à Narbonne : assurance des particuliers, gestion de patrimoine et assurance des entreprises. Trois agents généraux et neuf collaborateurs à votre écoute."
>
  <section class="hero">
    <div class="hero__photo"><Image photo="vignesAude" ratio={16 / 9} prioritaire /></div>
    <div class="conteneur hero__texte">
      <p class="hero__signature">{a.signature}</p>
      <h1>Votre agence d’assurance à Narbonne <span class="hero__domaines">Particuliers, patrimoine, entreprises</span></h1>
      <p class="hero__chapo">
        {NOMS_AGENTS}, agents généraux, et leurs {a.effectif} collaborateurs accompagnent les
        familles, les chefs d’entreprise et les indépendants du Narbonnais : protéger ce que vous avez construit, le faire
        fructifier, le transmettre.
      </p>
      <div class="actions">
        <a class="bouton bouton--blanc" href="/contact/">Prendre rendez-vous</a>
        <a class="bouton bouton--contour-blanc" href={`tel:${a.telephoneIntl}`}>Appeler le {a.telephone}</a>
      </div>
    </div>
  </section>


  <section class="themes conteneur" aria-label="Vos besoins">
    <ul>
      {themes.map((t) => (
        <li style={`--teinte:${t.teinte}`}>
          <a href={t.lien}>
            <span class="themes__icone" set:html={t.icone} />
            <span>{t.titre}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="section">
    <div class="conteneur">
      <hr class="filet" />
      <h2 class="titre-expertises">Trois expertises, un même interlocuteur</h2>
      <p class="chapo">
        Votre famille, votre patrimoine et votre entreprise sont liés. Avec un seul interlocuteur, rien n’est assuré deux fois et rien n’est oublié : c’est notre façon de travailler.
      </p>
      <div class="expertises">
        {expertises.map((e) => (
          <article class="expertise">
            <Image photo={e.photo} ratio={16 / 10} sizes="(min-width: 52rem) 24rem, 100vw" />
            <div class="expertise__corps">
              <h3><a href={e.lien}>{e.titre}</a></h3>
              <p>{e.texte}</p>
              <ul>{e.points.map((p) => <li>{p}</li>)}</ul>
              <span class="lien-fleche">Découvrir <Fleche /></span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--sable">
    <div class="conteneur">
      <h2>Nous connaissons vos métiers</h2>
      <p class="chapo">Les entreprises du Narbonnais ont leurs risques propres. Nous les assurons au quotidien.</p>
      <ul class="secteurs">
        {secteurs.map((s) => (
          <li class="secteur">
            <Image photo={s.photo} ratio={4 / 5} sizes="(min-width: 62rem) 15rem, 50vw" />
            <span>{s.titre}</span>
          </li>
        ))}
      </ul>
      <p class="secteurs__lien"><a class="lien-fleche" href="/entreprises/">Assurance des entreprises <Fleche /></a></p>
    </div>
  </section>

  <section class="section section--blanc">
    <div class="conteneur split">
      <div class="split__photo"><Image photo="rendezVous" ratio={4 / 3} sizes="(min-width: 56rem) 36rem, 100vw" /></div>
      <div>
        <h2>Notre méthode</h2>
        <ol class="etapes">
          {etapes.map((e) => (
            <li><h3>{e.titre}</h3><p>{e.texte}</p></li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <Avis />

  {articles.length > 0 && (
    <section class="section">
      <div class="conteneur">
        <div class="tete-bloc">
          <h2>Nos derniers conseils</h2>
          <a class="lien-fleche" href="/conseils/">Tous les conseils <Fleche /></a>
        </div>
        <ul class="cartes">{articles.map((art) => <CarteArticle article={art} />)}</ul>
      </div>
    </section>
  )}

  <section class="section section--bleu">
    <div class="conteneur split">
      <div class="split__photo"><Image photo="littoral" ratio={4 / 3} sizes="(min-width: 56rem) 36rem, 100vw" /></div>
      <div>
        <h2>Une agence de proximité, au cœur de Narbonne</h2>
        <p class="chapo">Nous recevons sur rendez-vous ou sans, boulevard Marcel Sembat, à deux pas du centre-ville.</p>
        <dl class="infos">
          <dt>Adresse</dt><dd>{a.adresse.rue}, {a.adresse.codePostal} {a.adresse.ville}</dd>
          <dt>Horaires</dt><dd>{a.horaires.texte}</dd>
          <dt>Téléphone</dt><dd><a href={`tel:${a.telephoneIntl}`}>{a.telephone}</a></dd>
        </dl>
        <div class="actions">
          <a class="bouton" href={a.google.itineraire} rel="noopener">Itinéraire</a>
          <a class="bouton bouton--clair" href={a.google.avis} rel="noopener">Lire nos avis Google</a>
        </div>
      </div>
    </div>
  </section>

  <section class="appel">
    <div class="appel__photo"><Image photo="vignoble" ratio={21 / 9} /></div>
    <div class="conteneur appel__texte">
      <h2>Parlons de vos projets</h2>
      <p>Un premier rendez-vous pour faire le point, à l’agence ou par téléphone.</p>
      <div class="actions">
        <a class="bouton bouton--blanc" href="/contact/">Prendre rendez-vous</a>
        <a class="bouton bouton--contour-blanc" href={`tel:${a.telephoneIntl}`}>{a.telephone}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; min-height: clamp(34rem, 86vh, 52rem); display: flex; align-items: flex-end; color: var(--blanc); background: var(--encre); overflow: hidden; }
  .hero__photo { position: absolute; inset: 0; }
  .hero__photo :global(img) { width: 100%; height: 100%; object-fit: cover; animation: zoom 14s ease-out both; }
  .hero::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(23, 36, 86, 0.15) 0%, rgba(23, 36, 86, 0.55) 45%, rgba(23, 36, 86, 0.92) 100%);
  }
  .hero__texte { position: relative; z-index: 1; padding-block: 6rem clamp(5rem, 9vw, 7rem); }
  .hero__domaines { display: block; font-size: 0.5em; font-weight: 500; color: var(--salin); margin-top: 0.5em; letter-spacing: 0; }
  .hero h1 { color: var(--blanc); max-width: 20ch; font-size: clamp(2.3rem, 1.4rem + 4vw, 4.4rem); }
  .hero__signature { font-family: var(--serif); font-style: italic; color: var(--salin); font-size: 1.15rem; margin-bottom: 0.8rem; }
  .hero__chapo { max-width: 56ch; font-size: clamp(1.05rem, 1rem + 0.35vw, 1.22rem); color: #e4e9f5; margin-bottom: 1.8rem; }
  @keyframes zoom { from { transform: scale(1.08); } to { transform: scale(1); } }

  .expertises { display: grid; gap: 1.8rem; margin-top: 2.5rem; }
  @media (min-width: 52rem) { .expertises { grid-template-columns: repeat(3, 1fr); } }
  .expertise {
    position: relative; background: var(--blanc); border-radius: var(--rayon-photo); overflow: hidden;
    box-shadow: var(--ombre); display: flex; flex-direction: column;
  }
  .expertise :global(img) { aspect-ratio: 16 / 10; object-fit: cover; width: 100%; transition: transform 500ms ease; }
  .expertise:hover :global(img) { transform: scale(1.03); }
  .expertise__corps { padding: 1.6rem 1.6rem 1.8rem; }
  .expertise h3 { font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem); }
  .expertise h3 a { color: var(--encre); text-decoration: none; }
  .expertise h3 a::after { content: ''; position: absolute; inset: 0; }
  .expertise p { color: var(--gris); }
  .expertise ul { list-style: none; padding: 0; margin: 0 0 1.3rem; display: grid; gap: 0.5rem; }
  .expertise li { padding-left: 1.6rem; position: relative; }
  .expertise li::before {
    content: ''; position: absolute; left: 0; top: 0.45em; width: 0.9rem; height: 0.55rem;
    border-left: 2px solid var(--robine); border-bottom: 2px solid var(--robine); transform: rotate(-45deg);
  }
  .expertise .lien-fleche { color: var(--robine); }

  .secteurs { list-style: none; padding: 0; margin: 2.2rem 0 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.9rem; }
  @media (min-width: 62rem) { .secteurs { grid-template-columns: repeat(5, 1fr); gap: 1.1rem; } }
  .secteur { position: relative; border-radius: var(--rayon-photo); overflow: hidden; }
  .secteur:last-child:nth-child(odd) { grid-column: 1 / -1; }
  @media (min-width: 62rem) { .secteur:last-child:nth-child(odd) { grid-column: auto; } }
  .secteur :global(img) { aspect-ratio: 4 / 5; object-fit: cover; width: 100%; }
  .secteur:last-child:nth-child(odd) :global(img) { aspect-ratio: 16 / 9; }
  @media (min-width: 62rem) { .secteur:last-child:nth-child(odd) :global(img) { aspect-ratio: 4 / 5; } }
  .secteur::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 45%, rgba(23, 36, 86, 0.85)); }
  .secteur span {
    position: absolute; left: 1rem; right: 1rem; bottom: 0.9rem; z-index: 1;
    color: var(--blanc); font-family: var(--serif); font-weight: 600; font-size: 1.1rem; line-height: 1.2;
  }
  .secteurs__lien { margin-top: 1.6rem; }

  .etapes { list-style: none; counter-reset: etape; padding: 0; margin: 1.6rem 0 0; display: grid; gap: 1.3rem; }
  .etapes li { counter-increment: etape; display: grid; grid-template-columns: 2.8rem 1fr; column-gap: 1rem; }
  .etapes li::before {
    content: counter(etape); grid-row: span 2; width: 2.8rem; height: 2.8rem; border-radius: 50%;
    display: grid; place-items: center; background: var(--robine-clair); color: var(--robine-fonce);
    font-family: var(--serif); font-weight: 650; font-size: 1.2rem;
  }
  .etapes h3 { margin: 0.35rem 0 0.2rem; font-size: 1.2rem; }
  .etapes p { margin: 0; color: var(--gris); }

  .tete-bloc { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 0.5rem 1.5rem; margin-bottom: 1.8rem; }
  .tete-bloc h2 { margin: 0; }

  .infos { display: grid; grid-template-columns: auto 1fr; gap: 0.5rem 1.2rem; margin: 0 0 1.8rem; }
  .infos dt { font-weight: 650; color: var(--encre); }
  .infos dd { margin: 0; }

  .appel { position: relative; color: var(--blanc); background: var(--encre); overflow: hidden; text-align: center; }
  .appel__photo { position: absolute; inset: 0; }
  .appel__photo :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .appel::after { content: ''; position: absolute; inset: 0; background: rgba(23, 36, 86, 0.72); }
  .appel__texte { position: relative; z-index: 1; padding-block: clamp(4rem, 10vw, 7rem); display: flex; flex-direction: column; align-items: center; }
  .appel h2 { color: var(--blanc); font-size: clamp(2rem, 1.4rem + 2.6vw, 3.4rem); }
  .appel p { color: #e4e9f5; font-size: 1.15rem; margin-bottom: 1.6rem; }
  .appel .actions { justify-content: center; }
  .themes { position: relative; z-index: 2; margin-top: -3.2rem; }
  .themes ul { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.7rem; }
  @media (min-width: 48rem) { .themes ul { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 70rem) { .themes ul { grid-template-columns: repeat(7, 1fr); } }
  .themes a {
    display: flex; flex-direction: column; gap: 0.7rem; height: 100%;
    background: var(--blanc); border-radius: var(--rayon-photo); padding: 1.1rem 1rem 1.2rem;
    text-decoration: none; color: var(--encre); font-weight: 650; line-height: 1.25;
    box-shadow: 0 12px 30px -18px rgba(23, 36, 86, 0.45); transition: transform 150ms, box-shadow 150ms;
  }
  .themes a:hover { transform: translateY(-3px); box-shadow: 0 18px 36px -18px rgba(23, 36, 86, 0.55); color: var(--robine-fonce); }
  .themes__icone { width: 3rem; height: 3rem; border-radius: 50%; background: var(--teinte); color: var(--robine); display: grid; place-items: center; }
</style>
