---
import { AGENCE } from '../data/agence';
const chemin = Astro.url.pathname;
const liens = [
  { href: '/conseils/', label: 'Conseils' },
  { href: '/agence/', label: "L'agence" },
  { href: '/contact/', label: 'Contact' },
];
const actif = (href: string) => chemin.startsWith(href);
---
<header class="entete">
  <div class="conteneur entete__barre">
    <a class="marque" href="/" aria-label={`${AGENCE.nom}, accueil`}>
      <span class="marque__nom">Agence BBC</span>
      <span class="marque__sous">Assurance &amp; Banque à Narbonne</span>
    </a>
    <nav class="nav" aria-label="Navigation principale">
      {liens.map((l) => (
        <a href={l.href} aria-current={actif(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
    <a class="appel" href={`tel:${AGENCE.telephoneIntl}`}>
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
      <span>{AGENCE.telephone}</span>
    </a>
  </div>
</header>

<style>
  .entete {
    background: var(--blanc);
    border-bottom: 1px solid var(--pierre);
    position: sticky;
    top: 0;
    z-index: 20;
  }
  .entete__barre {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas: 'marque appel' 'nav nav';
    align-items: center;
    gap: 0.4rem 1rem;
    padding-block: 0.7rem 0.5rem;
  }
  .marque {
    grid-area: marque;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--encre);
    font-family: var(--titre);
    line-height: 1.1;
  }
  .marque__nom { font-weight: 800; font-size: 1.3rem; letter-spacing: -0.02em; }
  .marque__sous { font-size: 0.8rem; color: var(--gris); margin-top: 0.15rem; }
  .nav {
    grid-area: nav;
    display: flex;
    gap: 1.4rem;
    font-family: var(--titre);
    font-size: 0.98rem;
    font-weight: 550;
  }
  .nav a {
    color: var(--encre);
    text-decoration: none;
    padding-block: 0.35rem;
    border-bottom: 2px solid transparent;
  }
  .nav a:hover { border-bottom-color: var(--pierre); }
  .nav a[aria-current='page'] { border-bottom-color: var(--robine); color: var(--robine-fonce); }
  .appel {
    grid-area: appel;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--titre);
    font-weight: 650;
    font-size: 0.95rem;
    color: var(--blanc);
    background: var(--robine);
    padding: 0.55rem 0.85rem;
    border-radius: var(--rayon);
    text-decoration: none;
    white-space: nowrap;
  }
  .appel:hover { background: var(--robine-fonce); color: var(--blanc); }

  @media (min-width: 52rem) {
    .entete__barre {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: 'marque nav appel';
      padding-block: 0.9rem;
    }
    .nav { justify-content: flex-end; gap: 2rem; margin-right: 0.5rem; }
  }
</style>
