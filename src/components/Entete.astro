---
import { AGENCE } from '../data/agence';
const chemin = Astro.url.pathname;
const liens = [
  { href: '/particuliers/', label: 'Particuliers' },
  { href: '/patrimoine/', label: 'Patrimoine' },
  { href: '/entreprises/', label: 'Entreprises' },
  { href: '/conseils/', label: 'Conseils' },
  { href: '/agence/', label: "L'agence" },
  { href: '/contact/', label: 'Contact' },
];
const actif = (href: string) => chemin.startsWith(href);
---
<header class="entete">
  <div class="conteneur entete__barre">
    <a class="marque" href="/" aria-label={`${AGENCE.nom}, accueil`}>
      <img class="marque__logo" src="/img/logo-blason.png" alt="" width="285" height="279" />
      <span class="marque__textes">
        <span class="marque__nom">Agence BBC</span>
        <span class="marque__sous">Assurance <span class="esperluette">&amp;</span> Banque</span>
      </span>
    </a>

    <nav class="nav" aria-label="Navigation principale">
      {liens.map((l) => <a href={l.href} aria-current={actif(l.href) ? 'page' : undefined}>{l.label}</a>)}
      <a class="nav__rdv" href="/contact/">Prendre rendez-vous</a>
    </nav>

    <details class="menu">
      <summary aria-label="Ouvrir le menu">
        <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        Menu
      </summary>
      <nav class="menu__panneau" aria-label="Navigation principale (mobile)">
        {liens.map((l) => <a href={l.href} aria-current={actif(l.href) ? 'page' : undefined}>{l.label}</a>)}
        <a class="bouton" href={`tel:${AGENCE.telephoneIntl}`}>Appeler le {AGENCE.telephone}</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .entete {
    position: sticky; top: 0; z-index: 30;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--pierre);
  }
  .entete__barre { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 4.4rem; }
  .marque { display: flex; align-items: center; gap: 0.7rem; text-decoration: none; color: var(--encre); }
  .marque__textes { display: flex; flex-direction: column; line-height: 1.1; }
  .marque__logo { height: 2.9rem; width: auto; flex: none; }
  .marque__nom { font-family: var(--serif); font-weight: 700; font-size: 1.3rem; letter-spacing: -0.01em; color: var(--robine); }
  .marque__sous { font-size: 0.82rem; color: var(--encre); margin-top: 0.1rem; }
  .esperluette { color: var(--rouge); font-weight: 700; }

  .nav { display: none; align-items: center; gap: 1.35rem; font-weight: 550; font-size: 0.98rem; }
  .nav a { color: var(--encre); text-decoration: none; padding-block: 0.4rem; border-bottom: 2px solid transparent; }
  .nav a:hover { border-bottom-color: var(--pierre); }
  .nav a[aria-current='page'] { border-bottom-color: var(--robine); color: var(--robine-fonce); }
  .nav .nav__rdv {
    background: var(--robine); color: var(--blanc); padding: 0.6rem 1.1rem; border-radius: 999px; border: 0; font-weight: 650;
  }
  .nav .nav__rdv:hover { background: var(--robine-fonce); color: var(--blanc); }

  .menu { position: relative; }
  .menu summary {
    list-style: none; cursor: pointer; display: flex; align-items: center; gap: 0.4rem;
    font-weight: 650; padding: 0.55rem 0.9rem; border: 1px solid var(--pierre); border-radius: 999px; background: var(--blanc);
  }
  .menu summary::-webkit-details-marker { display: none; }
  .menu__panneau {
    position: absolute; right: 0; top: calc(100% + 0.6rem); width: min(19rem, calc(100vw - 2rem));
    background: var(--blanc); border-radius: var(--rayon-photo); box-shadow: 0 20px 50px -20px rgba(23, 36, 86, 0.5);
    padding: 0.8rem; display: flex; flex-direction: column;
  }
  .menu__panneau a:not(.bouton) {
    color: var(--encre); text-decoration: none; font-weight: 600; font-size: 1.05rem;
    padding: 0.75rem 0.8rem; border-radius: var(--rayon);
  }
  .menu__panneau a:not(.bouton):hover, .menu__panneau a[aria-current='page'] { background: var(--robine-clair); }
  .menu__panneau .bouton { margin-top: 0.6rem; }

  @media (min-width: 68rem) {
    .nav { display: flex; }
    .menu { display: none; }
  }
</style>
