---
import { AGENCE } from '../data/agence';
interface Props { sujet?: string; titre?: string; texte?: string }
const {
  sujet,
  titre = 'Faire le point avec un conseiller',
  texte = 'À l’agence, boulevard Marcel Sembat à Narbonne, ou par téléphone : nous regardons votre situation et vous disons ce qui a du sens pour vous.',
} = Astro.props;
const lienRdv = sujet ? `/contact/?sujet=${sujet}` : '/contact/';
---
<section class="rdv" aria-label="Prendre rendez-vous">
  <div>
    <h2 class="rdv__titre">{titre}</h2>
    <p>{texte}</p>
  </div>
  <div class="actions">
    <a class="bouton bouton--blanc" href={lienRdv}>Demander un rendez-vous</a>
    <a class="bouton bouton--contour-blanc" href={`tel:${AGENCE.telephoneIntl}`}>{AGENCE.telephone}</a>
  </div>
</section>

<style>
  .rdv {
    margin: 3rem 0 0; padding: clamp(1.6rem, 4vw, 2.6rem);
    background: var(--encre); color: #dde3f2; border-radius: var(--rayon-photo);
    display: grid; gap: 1.2rem; align-items: center;
    background-image: radial-gradient(circle at 100% 0%, rgba(239, 64, 67, 0.16), transparent 55%);
  }
  .rdv__titre { margin: 0 0 0.5rem; font-size: clamp(1.4rem, 1.2rem + 0.8vw, 1.9rem); color: var(--blanc); }
  .rdv p { margin: 0; max-width: 52ch; }
  @media (min-width: 56rem) { .rdv { grid-template-columns: 1fr auto; } }
</style>
